# Local secrets — never commit
.zsh_secrets
*_secrets
*.secret

# Ansible Vault password files
.vault_pass
*.vault-pass

# SSH — track only config, never private keys / known_hosts
ssh/.ssh/*
!ssh/.ssh/config

# Google Calendar OAuth client secret — deploy via Ansible Vault
# real file lives at ~/.config/waybar/google-calendar/client_secret.json (via stow)
waybar/.config/waybar/google-calendar/client_secret.json
