{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        // "hyprland/window",
        "custom/separator",
        "hyprland/workspaces",
        "custom/separator",
        "mpris"
    ],

    "modules-center": [
        "clock",
        "custom/separator",
        "custom/weather"
    ],

    "modules-right": [
        "custom/performance",
        "custom/separator",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "custom/separator",
        "custom/notifications",
        "custom/separator",
        "custom/power"
    ],

    // ── Left ─────────────────────────────────────────────────────────────────

    "hyprland/window": {
        "format": " {title}",
        "max-length": 40,
        "separate-outputs": true
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active":   "",
            "occupied": "",
            "empty":    ""
        },
        "persistent-workspaces": {
            "*": 5
        },
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },

    "mpris": {
        "format": "{player_icon} {title}",
        "format-paused": " {title}",
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "firefox": "󰈹",
            "chromium": ""
        },
        "status-icons": {
            "paused": ""
        },
        "max-length": 40,
        "ignored-players": ["firefox"]
    },

    // ── Center ────────────────────────────────────────────────────────────────

    "clock": {
        // "format": "󰥔 {:%H:%M  󰃭 %a %d %b}",
        // "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
	// "on-click": "waybar-gcal agenda",
	// "on-click-right": "waybar-gcal month",
	// "on-click-middle": "waybar-gcal agenda --timezone Asia/Singapore",
	// "calendar": {
	//   "mode": "month",
	//   "weeks-pos": "right",
	//   "iso8601": true
	// },
	"exec": "/usr/share/waybar-ycal/bar.py",
	"on-click": "/usr/share/waybar-ycal/toggle.sh",
	"interval": 60,
	"return-type": "json"
    },

    "custom/weather": {
        "exec": "curl -sf 'https://wttr.in/?format=%c+%t' | tr -d '+'",
        "interval": 1800,
        "tooltip": true,
        "tooltip-exec": "curl -sf 'https://wttr.in/?format=%l:+%C,+%t+(%f),+%h+humidity'",
        "on-click": "~/.config/waybar/scripts/popup.sh weather"
    },

    // ── Right ─────────────────────────────────────────────────────────────────

    "custom/performance": {
        "exec": "~/.config/waybar/scripts/performance.sh",
        "interval": 5,
        "tooltip": true,
        "tooltip-exec": "~/.config/waybar/scripts/performance-detail.sh",
        "on-click": "~/.config/waybar/scripts/popup.sh btop"
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "format-disabled": "󰂲",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "  {device_alias}",
        "tooltip-format-enumerate-connected-battery": "  {device_alias} ({device_battery_percentage}%)",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "{timeTo}\n{power}W"
    },

    "custom/notifications": {
        "exec": "~/.config/waybar/scripts/notifications.sh",
        "interval": "once",
        "signal": 1,
        "return-type": "json",
        "on-click": "~/.config/waybar/scripts/popup.sh swaync",
        "on-click-right": "swaync-client -d"
    },

    // ── Shared ────────────────────────────────────────────────────────────────

    "custom/separator": {
        "format": " ",
        "tooltip": false
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout"
    }
}
