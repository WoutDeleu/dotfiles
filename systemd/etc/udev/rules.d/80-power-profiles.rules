# Auto-switch power profile based on AC adapter state
# AC plugged in  → balanced
# AC unplugged   → power-saver
# powerprofilesctl is a Python script; invoke it via /usr/bin/python3 explicitly
# so a mise/pyenv-shimmed python3 on PATH can't shadow the system gi bindings.
SUBSYSTEM=="power_supply", KERNEL=="ACAD", ATTR{online}=="1", RUN+="/usr/bin/systemd-run --no-block /usr/bin/python3 /usr/bin/powerprofilesctl set balanced"
SUBSYSTEM=="power_supply", KERNEL=="ACAD", ATTR{online}=="0", RUN+="/usr/bin/systemd-run --no-block /usr/bin/python3 /usr/bin/powerprofilesctl set power-saver"
